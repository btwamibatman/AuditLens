
APP_NAME="AuditLens"
ENVIRONMENT=dev
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite (по умолчанию, ничего ставить не нужно):
DATABASE_URL=sqlite:///./data/app.db
# Postgres (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

ENABLE_AUTH=false
ENABLE_UPLOADS=false
ENABLE_AI=false

SECRET_KEY=dev-secret-change-me-please-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=10080

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- CQA: LLM-оценка диалогов ---
# Ключ вставляйте ТОЛЬКО в .env (он в .gitignore). Пустой ключ => mock-режим.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=medium
# Общий бюджет времени на одну оценку (включая transport retry и валидационный повтор), сек.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# Общий предел одновременно выполняемых оценок в одном процессе (batch + одиночные).
LLM_BATCH_CONCURRENCY=4
# Тарифы для расчётной оценки стоимости (USD за 1M токенов; не являются счётом биллинга).
LLM_PRICE_INPUT_PER_1M=1.50
LLM_PRICE_OUTPUT_PER_1M=7.50

# API организаторов (ссылка GET для DEV без параметра group_id)
DATASET_API_URL=
